{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The relay is deployed independently of control-plane/: no secrets, no
	// GitHub credential, no routes. The custom domain is attached out-of-band.
	"name": "dark-factory-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"vars": {
		"PWA_ORIGIN": "https://app.darkfactory.build"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "FACTORY_RELAY",
				"class_name": "FactoryRelay"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["FactoryRelay"]
		}
	]
}
