{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The relay is deployed independently of control-plane/: no secrets and
	// no GitHub credential. Its only route is the custom domain below.
	"name": "dark-factory-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-22",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "relay.darkfactory.build",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"PWA_ORIGIN": "https://app.darkfactory.build"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "FACTORY_RELAY",
				"class_name": "FactoryRelay"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["FactoryRelay"]
		}
	]
}
