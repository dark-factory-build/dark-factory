{
  "name": "@dark-factory/ui",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["dist/src/**/*.css"],
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./styles.css": "./dist/src/factory-console.css"
  },
  "files": ["dist/src"],
  "scripts": { "typecheck": "tsc --noEmit", "build": "tsc -p tsconfig.json && cp src/factory-console.css dist/src/factory-console.css" },
  "dependencies": { "@dark-factory/client": "workspace:*" },
  "peerDependencies": { "react": "19.1.0" },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3"
  }
}
