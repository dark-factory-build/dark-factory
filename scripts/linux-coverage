# Linux gate coverage (#1622). On Linux, go-check.sh vets and go-ci-owned.sh
# tests only packages marked proved, and go-ci-owned.sh first refuses unless
# this file names every Go package and every Darwin-only test file exactly
# once, so an exclusion cannot pass silently as a green Linux gate.
#
# package PATH proved|SLICE  proved runs natively; otherwise the slice that ports it
# test FILE CLASS SLICE      shared: portable assertions, untag when the package is ported
#                            linux-equivalent: needs its own native Linux test
#                            macos-only: no Linux counterpart is needed
#
# The Linux leg gates only proved packages until L08 makes the whole runtime
# required and L12 requires complete support; the macOS gate stays required.

package cmd/factory-runner L08
package cmd/factoryctl L08
package cmd/factoryd L08
